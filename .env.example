NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google Maps Platform — จำกัด key ด้วย HTTP referrer (localhost + โดเมน Vercel) และเปิดเฉพาะ Maps JavaScript API กับ Routes API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (Vector, JavaScript) จาก Map Management (ว่าง = DEMO_MAP_ID ใช้ตอนพัฒนาเท่านั้น)
NEXT_PUBLIC_GOOGLE_MAP_ID=
