NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# เฉพาะ server (route /share/[token]) — ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Google Maps Platform — จำกัด key ด้วย HTTP referrer (localhost + โดเมน Vercel) และเปิดเฉพาะ Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (Vector, JavaScript) จาก Map Management (ว่าง = DEMO_MAP_ID ใช้ตอนพัฒนาเท่านั้น)
NEXT_PUBLIC_GOOGLE_MAP_ID=
